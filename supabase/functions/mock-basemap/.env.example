# Server-only configuration for the normal staging mock-basemap function.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY come from the normal Edge runtime.
LOCATION_MOCK_BASEMAP_ENABLED=false
LOCATION_MAP_TILES_ENABLED=false
# Reuse the existing account/key; never create a second mock provider budget.
GEOAPIFY_MAPS_KEY=
# Public mock API key; this is not a mock service credential.
MOCK_SUPABASE_PUBLISHABLE_KEY=
