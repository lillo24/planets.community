NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-cli-value
NEXT_PUBLIC_SENTRY_DSN=
# Optional real store/download links. Leave empty until listings exist.
# HTTPS without credentials or a fragment; local loopback HTTP is allowed only
# when NEXT_PUBLIC_APP_ENV=local. App links use https://planets.community.
NEXT_PUBLIC_PLANETS_ANDROID_DOWNLOAD_URL=
NEXT_PUBLIC_PLANETS_IOS_DOWNLOAD_URL=
# Leave these empty until final production app identities are known. Empty or
# bootstrap values keep both /.well-known association endpoints disabled.
PLANETS_ANDROID_APP_LINK_PACKAGE_ID=
PLANETS_ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=
PLANETS_IOS_TEAM_ID=
PLANETS_IOS_BUNDLE_ID=
