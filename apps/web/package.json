{
  "name": "@planets/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "invitation:build:local": "vite build --config static-invitations/vite.config.mts --mode trial-local",
    "invitation:build:staging": "vite build --config static-invitations/vite.config.mts --mode trial-staging",
    "invitation:preview": "wrangler dev --config static-invitations/wrangler.jsonc --local --port 8797 --log-level error",
    "invitation:dry-run": "wrangler deploy --config static-invitations/wrangler.jsonc --dry-run",
    "invitation:check": "node static-invitations/check-build.mjs",
    "invitation:deploy:staging": "node static-invitations/deploy.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@sentry/nextjs": "10.73.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.113.0",
    "class-variance-authority": "^0.7.1",
    "client-only": "0.0.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
